---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'writing' | 'links' | 'bio';
}

const {
  title,
  description = site.siteDescription,
  activeNav,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.siteName ? title : `${title} — ${site.siteName}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:creator" content="@apoorv3E" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <header>
    <nav>
      <a href="/" class="nav-logo">{site.siteName}</a>
      <div class="nav-links">
        <a href="/writing" class={activeNav === 'writing' ? 'active' : ''}>Writing</a>
        <a href="/links" class={activeNav === 'links' ? 'active' : ''}>Links</a>
        <a href="/bio" class={activeNav === 'bio' ? 'active' : ''}>Bio</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <span>© {new Date().getFullYear()} {site.siteName}. {site.footerNote}</span>
      <div class="footer-links">
        {site.socialLinks.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
    </div>
  </footer>
</body>
</html>
